```gitignore
# ==============================
# Environment variables and secrets
# ==============================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
serviceAccount*.json
firebase-adminsdk*.json

# ==============================
# Node.js / Next.js
# ==============================
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Python / FastAPI
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.venv/
venv/
ENV/
env/

# ==============================
# Testing
# ==============================
.coverage
.coverage.*
htmlcov/
.nyc_output/

# ==============================
# Firebase
# ==============================
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ==============================
# IDEs and editors
# ==============================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==============================
# Logs and temporary files
# ==============================
*.log
tmp/
temp/
.cache/

# ==============================
# Local databases and backups
# ==============================
*.db
*.sqlite
*.sqlite3
*.bak
